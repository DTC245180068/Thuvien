# =================================================================
# SMARTLIB - CẤU HÌNH BIẾN MÔI TRƯỜNG MẪU (.env.example)
# Học phần: Ứng dụng trí tuệ nhân tạo - ICTU
# Sinh viên: Nguyễn Trung Học - MSSV: DTC245180174
# =================================================================

# 1. Cấu hình Máy chủ Backend (FastAPI / Uvicorn)
PORT=8000
HOST=0.0.0.0
ENV=development
JWT_SECRET=SmartLib_Secret_Key_Hoc_2006

# -----------------------------------------------------------------
# 2. CẤU HÌNH CƠ SỞ DỮ LIỆU MYSQL 8.0 (CHUẨN 3NF - 7 BẢNG)
# -----------------------------------------------------------------
DB_ENGINE=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=ChangeMe_Root_Password
MYSQL_DATABASE=smartlib_db
MYSQL_USER=smartlib
MYSQL_PASSWORD=ChangeMe_User_Password

# -----------------------------------------------------------------
# 3. CẤU HÌNH TRỢ LÝ AI TẠO SINH (GOOGLE GEMINI API / OPENAI API)
# Lưu ý Bảo mật (Tiêu chí 3.4): KHÔNG hardcode API Key vào mã nguồn.
# Khi để trống, hệ thống tự động kích hoạt Multi-tier Smart Fallback.
# -----------------------------------------------------------------
# Lấy Google Gemini / Vertex AI API Key (bắt đầu bằng 'AQ...' hoặc 'AIza...')
GEMINI_API_KEY=
# Lấy OpenAI API Key tại: https://platform.openai.com/api-keys
OPENAI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash

# 4. Cấu hình Frontend (React Vite)
VITE_API_URL=http://localhost:8000/api
